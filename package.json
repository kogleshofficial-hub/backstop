{
  "name": "backstop",
  "private": true,
  "version": "0.1.0",
  "description": "AI agent action policy, execution gating, and governance infrastructure",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build --workspace=@backstop/core && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check": "npm run build --workspace=@backstop/core && tsc --noEmit",
    "predev": "npm run build --workspace=@backstop/core",
    "verify": "npm test && npm run check && npm run build && npm audit --audit-level=high"
  },
  "dependencies": {
    "@backstop/core": "0.1.0",
    "lucide-react": "^1.62.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
